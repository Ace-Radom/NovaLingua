<local:BaseWindow x:Class="NovaLingua.Windows.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:NovaLingua.Windows"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="WelcomeWindow" Height="450" Width="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            ShowMinimize="False"
            ShowMaximize="False"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="16,0,8,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    Text="NovaLingua"
                    FontSize="26"
                    FontWeight="Bold" />

                <StackPanel
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    VerticalAlignment="Top">
                    <TextBlock
                        Text="Recent Projects:"
                        FontSize="14" />
                    
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.Column="1"
                Margin="8,0,16,4"
                VerticalAlignment="Center">
                
                <ui:Button
                    Content="Create Project" 
                    Icon="{ui:SymbolIcon Add24}"
                    HorizontalAlignment="Stretch"
                    Padding="12" />

                <ui:Button
                    x:Name="_loadProjectButton"
                    Margin="0,8,0,0"
                    Content="Load Project" 
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    Appearance="Primary"
                    HorizontalAlignment="Stretch"
                    Padding="12"
                    Click="LoadProjectButton_Click"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</local:BaseWindow>
